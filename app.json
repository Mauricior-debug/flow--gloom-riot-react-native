{
  "expo": {
    "name": "GLOOM RIOT",
    "slug": "gloom-riot",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "gloomriot",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gloomriot.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#9BE36B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.gloomriot.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8E8"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "orientationLock": "DEFAULT"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "naza123",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1e40879-a3f4-46c1-bdea-2a97a1af9de7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/a1e40879-a3f4-46c1-bdea-2a97a1af9de7"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
